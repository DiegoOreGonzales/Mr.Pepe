# 1. Datos de Base de Datos PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mrpepepassword
POSTGRES_DB=mrpepe
DATABASE_URL=postgresql://postgres:mrpepepassword@localhost:5432/mrpepe

# 2. Datos del Contribuyente (Emisor - Formulario 7140)
SUNAT_RUC=10418236103
SUNAT_RAZON_SOCIAL="DE LA CRUZ BALDEON ROCIO ELENA"
SUNAT_NOMBRE_COMERCIAL="MR. PEPE"
SUNAT_DIRECCION="Jr. Junín 413 con Av. 13 de Noviembre - El Tambo - Huancayo"
SUNAT_DEPARTAMENTO="JUNIN"
SUNAT_PROVINCIA="HUANCAYO"
SUNAT_DISTRITO="EL TAMBO"
SUNAT_UBIGEO="120114"

# 3. Certificado Digital Tributario (CDT)
# Colocar el archivo descargado en la carpeta: web-admin/certs/
SUNAT_CERT_PATH="./certs/certificado.pfx"
SUNAT_CERT_PIN="RocioDeLaCruz3101"

# 4. Credenciales Clave SOL (Usuario Secundario con permisos de comprobantes)
# Crear en SUNAT SOL -> Administracion de Usuarios Secundarios -> Asignar CPE
SUNAT_USUARIO_SOL="FACTURADOR1"
SUNAT_CLAVE_SOL="tu_clave_secundaria_aqui"

# 5. Modo de Operación:
# - "DIRECTO": Transmisión directa a SUNAT mediante UBL 2.1
# - "FACTURALO": API REST de Facturalo PRO auto-hospedado
# - "SIMULADO": Modo contingencia offline (genera Hash y QR para imprimir tickets sin bloquear la caja)
SUNAT_MODO="SIMULADO"
SUNAT_AMBIENTE="beta"

# 6. Datos de Facturalo PRO (Solo si se usa el contenedor auto-hospedado)
SUNAT_FACTURALO_URL="http://localhost:8000"
SUNAT_FACTURALO_TOKEN=""

